{"source_body":"{\n    BITMAP *bg;\n    int y;\n    int ok;\n    char new_name[32];\n    int res;\n    char buf[129];\n\n    bg=create_bitmap(gfx_driver->w,gfx_driver->h);\n    blit(screen,bg,0,0,0,0,gfx_driver->w,gfx_driver->h);\n    memset(new_name,0,sizeof(new_name));\n    for (;;) {\n        checkMenuFocus();\n        blit(bg,screen,0,0,0,0,gfx_driver->w,gfx_driver->h);\n        set_trans_blender(0,0,0,158);\n        drawing_mode(DRAW_MODE_TRANS,0,0,0);\n        rectfill(screen,0,0,gfx_driver->w,gfx_driver->h,makecol(0,0,0));\n        solid_mode();\n        draw_sprite(screen,data[87].dat,100,120);\n        textout_ex(screen,data[51].dat,\"Welcome to Icy Tower\",130,127,-1,-1);\n        textout_ex(screen,data[54].dat,\"Yo, wazup? In Icy Tower, all your highscores\",130,160,0,-1);\n        textout_ex(screen,data[54].dat,\"and progress will be stored in a personal profile.\",130,175,0,-1);\n        textout_ex(screen,data[54].dat,\"AWESOME!\",130,190,0,-1);\n        textout_ex(screen,data[54].dat,\"Please enter a name for your profile:\",130,220,0,-1);\n        textout_right_ex(screen,data[54].dat,\"...and press enter.\",430,260,0,-1);\n        rect(screen,129,240,430,258,makecol(255,255,255));\n        rectfill(screen,129,240,430,258,makecol(80,80,80));\n        blit_to_screen(screen);\n        ok=get_string(screen,new_name,300,32,data[54].dat,130,240,makecol(0,0,0),-1);\n        if (ok<0 || (ok>0 && !new_name[0]))\n            continue;\n        if (ok==0) {\n            my_alert(\"You can create a profile later in the OPTIONS menu.\",\"Oh Well...\",0,1);\n            profile=load_profile(\"guest\");\n            if (!profile)\n                profile=create_profile(\"guest\",1);\n            syncOptionsFromProfile();\n            break;\n        }\n        replaceBadCharacters(new_name,'_');\n        profile=create_profile(new_name,0);\n        if (!profile) {\n            my_alert(\"That profile name is taken.\",\"Ooops!\",0,1);\n            continue;\n        }\n        sprintf(buf,\"Welcome %s!\",profile->handle);\n        my_alert(buf,\"Your profile has been created!\",0,1);\n        break;\n    }\n    destroy_bitmap(bg);\n    strcpy(options.lastProfile,profile->handle);\n    rebuild_profile_list(0);\n}","disassembly":{"original":[{"address":4248661,"bytes":"89e5","mnemonic":"mov","assembly":"mov    %esp,%ebp","dwarf_variables":[]},{"address":4248663,"bytes":"57","mnemonic":"push","assembly":"push   %edi","dwarf_variables":[]},{"address":4248664,"bytes":"56","mnemonic":"push","assembly":"push   %esi","dwarf_variables":[]},{"address":4248665,"bytes":"53","mnemonic":"push","assembly":"push   %ebx","dwarf_variables":[]},{"address":4248666,"bytes":"81ecfc000000","mnemonic":"sub","assembly":"sub    $0xfc,%esp","dwarf_variables":[]},{"address":4248672,"bytes":"a184da4d00","mnemonic":"mov","assembly":"mov    0x4dda84,%eax","dwarf_variables":[]},{"address":4248677,"bytes":"85c0","mnemonic":"test","assembly":"test   %eax,%eax","dwarf_variables":[]},{"address":4248679,"bytes":"0f849e050000","mnemonic":"je","assembly":"je     40da0b <_force_create_profile+0x5b7>","dwarf_variables":[]},{"address":4248685,"bytes":"8b5070","mnemonic":"mov","assembly":"mov    0x70(%eax),%edx","dwarf_variables":[]}],"candidate":[{"address":27729,"bytes":"89e5","mnemonic":"mov","assembly":"mov    %esp,%ebp","dwarf_variables":[]},{"address":27731,"bytes":"57","mnemonic":"push","assembly":"push   %edi","dwarf_variables":[]},{"address":27732,"bytes":"56","mnemonic":"push","assembly":"push   %esi","dwarf_variables":[]},{"address":27733,"bytes":"53","mnemonic":"push","assembly":"push   %ebx","dwarf_variables":[]},{"address":27734,"bytes":"81ecec000000","mnemonic":"sub","assembly":"sub    $0xec,%esp","dwarf_variables":[]},{"address":27740,"bytes":"a100000000","mnemonic":"mov","assembly":"mov    0x0,%eax","dwarf_variables":[]},{"address":27745,"bytes":"8b5070","mnemonic":"mov","assembly":"mov    0x70(%eax),%edx","dwarf_variables":[]},{"address":27748,"bytes":